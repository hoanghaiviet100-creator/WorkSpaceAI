# LLM Provider Selection: "mock" | "ollama" | "gemini"
LLM_PROVIDER=ollama
# Docker reviews generated claims by default. Set false to compare citation-only mode.
FEATURE1_SEMANTIC_VERIFY=true
# Experimental: allow Qwen Thinking for comparison and explanation questions.
FEATURE1_SELECTIVE_THINKING=false

# Local Ollama Settings (when LLM_PROVIDER=ollama)
# For local run outside Docker: http://localhost:11434
# For Docker Compose, it defaults to http://ollama:11434 automatically.
# If running Docker Compose but connecting to Ollama on your host machine, uncomment:
# OLLAMA_DOCKER_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud Gemini Fallback Settings (when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Retrieval & Verification Thresholds (R2 & R3)
RETRIEVAL_MIN_SCORE=0.35
CITATION_VERIFY_THRESHOLD=0.75

# Feature 3: local_mock simulates delivery. Set gmail_real to send via Gmail SMTP.
EMAIL_DISPATCH_MODE=local_mock
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
