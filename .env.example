# LLM Provider Selection: "mock" | "ollama" | "gemini"
LLM_PROVIDER=ollama

# Local Ollama Settings (when LLM_PROVIDER=ollama)
# For local run outside Docker: http://localhost:11434
# For Docker Compose, it defaults to http://ollama:11434 automatically.
# If running Docker Compose but connecting to Ollama on your host machine, uncomment:
# OLLAMA_DOCKER_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud Gemini Fallback Settings (when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Retrieval & Verification Thresholds (R2 & R3)
RETRIEVAL_MIN_SCORE=0.35
CITATION_VERIFY_THRESHOLD=0.75

# Feature 3: Email Assistant & Real Gmail SMTP Dispatch
EMAIL_DISPATCH_MODE=gmail_real
GMAIL_SENDER_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
