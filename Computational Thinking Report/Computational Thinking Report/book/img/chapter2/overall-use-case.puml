@startuml
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam wrapWidth 200
skinparam maxMessageSize 100

skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #3C4043
}

skinparam usecase {
  BackgroundColor #F8F9FA
  BorderColor #5F6368
  ArrowColor #3C4043
}

skinparam usecase<<F1>> {
  BackgroundColor #E8F0FE
  BorderColor #1A73E8
}

skinparam usecase<<F2>> {
  BackgroundColor #FEF7E0
  BorderColor #EA8600
}

skinparam usecase<<F3>> {
  BackgroundColor #E6F4EA
  BorderColor #137333
}

skinparam usecase<<Shared>> {
  BackgroundColor #F1F3F4
  BorderColor #5F6368
}

left to right direction

actor "Workspace\nMember" as U
actor "SMTP Server" as SMTP <<external>>

rectangle "WorkspaceAI System Boundary" {
  package "Feature 1: Evidence-Grounded Q&A" {
    usecase "UC-01\nUpload and Manage\nSources" as UC1 <<F1>>
    usecase "UC-02\nAsk Source-Grounded\nQuestion" as UC2 <<F1>>
    usecase "UC-03\nInspect Citation" as UC3 <<F1>>
  }

  package "Feature 2: Progress Management" {
    usecase "UC-04\nExtract and Review\nRequirements/Tasks" as UC4 <<F2>>
    usecase "UC-05\nManage Tasks on\nKanban Board" as UC5 <<F2>>
    usecase "UC-06\nReconcile Requirements\nwith Tasks" as UC6 <<F2>>
  }

  package "Feature 3: Email Reporting" {
    usecase "UC-07\nDraft Email" as UC7 <<F3>>
    usecase "UC-08\nReview and\nApprove Email" as UC8 <<F3>>
    usecase "UC-09\nSend Email and\nTrack Outcome" as UC9 <<F3>>
  }

  usecase "Verify Citations" as V <<Shared>>
}

U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC5
U --> UC6
U --> UC7
U --> UC8
U --> UC9

UC2 ..> V : <<include>>
UC7 ..> V : <<include>>

UC9 --> SMTP

note right of SMTP
  UC-09 is the sole use case
  with external side-effects
end note

note top of UC2
  UC-02, UC-04, and UC-07
  invoke internal Ollama LLM
end note
@enduml
